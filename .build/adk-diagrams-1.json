  "6.2": [
    {
      "after": "01",
      "d": {
        "kind": "layers",
        "title": "Fifteen hooks, grouped by what they wrap",
        "caption": "The middle three rows are the agent callbacks lifted to application scope. The top and bottom rows have no per-agent equivalent at all, and they are the reason plugins are not merely a convenience.",
        "items": [
          {
            "label": "before_run / after_run / on_run_error",
            "sub": "the whole invocation — every agent, every transfer",
            "tone": "violet"
          },
          {
            "label": "on_user_message",
            "sub": "before any agent runs — an unbypassable input check",
            "tone": "crit"
          },
          {
            "label": "before_agent / after_agent / on_agent_error",
            "sub": "per agent",
            "tone": "accent"
          },
          {
            "label": "before_model / after_model / on_model_error",
            "sub": "per model request",
            "tone": "accent"
          },
          {
            "label": "before_tool / after_tool / on_tool_error",
            "sub": "per tool call",
            "tone": "good"
          },
          {
            "label": "on_event / close",
            "sub": "every event emitted; shutdown flush",
            "tone": "warn"
